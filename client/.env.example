# Whisper Drop (Covert Chat) - Environment Configuration Example
# Copy this file to .env and configure your TURN server credentials for cross-network relay.

# TURN Server URL (e.g., turn:your-turn-server.com:3478 or turn:global.relay.metered.ca:80)
VITE_TURN_URL=turn:your-turn-server-host:port

# TURN Server Credentials
VITE_TURN_USERNAME=your_turn_username
VITE_TURN_CREDENTIAL=your_turn_credential_or_password
