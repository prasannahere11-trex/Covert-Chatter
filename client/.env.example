# Covert Chatter - Environment Configuration Example
# Copy this file to .env or configure these variables in Render dashboard settings.

# (Optional) Explicit Signaling Server WebSocket URL
# If empty, the client automatically auto-detects wss://<current-host>/ws
# VITE_SIGNALING_URL=wss://your-render-app.onrender.com/ws

# (Recommended for Mobile / Cross-Network NAT Traversal) TURN Server Configuration
# e.g., from Metered.ca (free tier) or OpenRelay
# VITE_TURN_URL=turn:global.relay.metered.ca:80
# VITE_TURN_USERNAME=your_turn_username
# VITE_TURN_CREDENTIAL=your_turn_credential_or_password

